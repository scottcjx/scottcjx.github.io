---
interface Props {
  items: any[];
  label: string;
}
const { items, label } = Astro.props;
---
<div class="work-list">
  {items.map((item) => (
    <article class="work-item">
      <div class="work-year">{item.data.date ? item.data.date.getFullYear() : '—'}</div>
      <div>
        <h3><a href={`/${item.collection}/${item.id}/`}>{item.data.title}</a></h3>
        <p>{item.data.excerpt || item.body?.replace(/\s+/g, ' ').slice(0, 180)}</p>
      </div>
      <div class="work-meta"><span>{item.data.type || label}</span>{item.data.venue || item.data.location || item.data.status || (item.collection === 'projects' ? 'Project' : 'Research')}</div>
    </article>
  ))}
</div>
